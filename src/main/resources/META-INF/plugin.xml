<idea-plugin>
    <id>com.github.hyxf.aicode-context-manager</id>
    <name>AICode Context Manager</name>
    <vendor email="xchao887@gmail.com" url="https://github.com/hyxf/aicode-context-manager">AICode</vendor>

    <description><![CDATA[
    <h2>AICode Context Manager</h2>
    <p>Manage code context files for AI assistance with one-click Markdown export.</p>
    <br/>
    <h3>Features:</h3>
    <ul>
      <li>Add/Remove files to AI context via right-click menu</li>
      <li>Visualize context files in Tool Window</li>
      <li>Support multi-module projects</li>
      <li>Auto-sync file changes (rename, move, delete)</li>
      <li>Export all context files as Markdown code package</li>
      <li>Multiple Context Groups support</li>
    </ul>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.terminal</depends>
    <depends>Git4Idea</depends>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup
                id="AICode"
                displayType="BALLOON"
                isLogByDefault="true"/>

        <!-- Tool Window -->
        <toolWindow
                id="AICode Context"
                anchor="right"
                icon="/icons/aicode.svg"
                factoryClass="com.aicode.feature.ai.ui.AICodeToolWindowFactory"/>

        <!-- Project Service -->
        <projectService
                serviceImplementation="com.aicode.feature.ai.service.AICodeFileService"/>

        <!-- Icon Provider -->
        <iconProvider implementation="com.aicode.feature.ai.provider.AICodeIconProvider" order="first"/>

        <!-- Editor Notification Provider -->
        <editorNotificationProvider implementation="com.aicode.feature.ai.provider.AICodeEditorNotificationProvider"/>
    </extensions>

    <actions>
        <group id="AICodeGroup" text="AI Code" popup="true" icon="icons/aicode.svg">
            <!-- 1. Project View: Keep in CutCopyPaste group at the bottom -->
            <add-to-group group-id="CutCopyPasteGroup" anchor="last"/>

            <!-- 2. Editor Tab: Force to FIRST position (Top of the menu) -->
            <add-to-group group-id="EditorTabPopupMenu" anchor="first"/>

            <action id="com.aicode.action.AddToAICodeAction"
                    class="com.aicode.feature.ai.action.AddToAICodeAction"
                    text="Add to AICode"
                    description="Add file to AICode context">
                <keyboard-shortcut keymap="$default" first-keystroke="ctrl shift Z"/>
                <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta shift Z"/>
            </action>

            <action id="com.aicode.action.RemoveFromAICodeAction"
                    class="com.aicode.feature.ai.action.RemoveFromAICodeAction"
                    text="Remove from AICode"
                    description="Remove file from AICode context">
                <keyboard-shortcut keymap="$default" first-keystroke="ctrl shift X"/>
                <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta shift X"/>
            </action>

            <action id="com.aicode.action.CopyRelativePathAction"
                    class="com.aicode.feature.ai.action.CopyRelativePathAction"
                    text="Copy Relative Path"
                    description="Copy path relative to the project root"/>

            <action id="com.aicode.action.AddToTerminalAction"
                    class="com.aicode.feature.ai.action.AddToTerminalAction"
                    text="Add to Terminal"
                    description="Insert the selected file path at the terminal cursor"/>

            <action id="com.aicode.action.CopyMarkdownAction"
                    class="com.aicode.feature.ai.action.CopyMarkdownAction"
                    text="Copy as Markdown"
                    description="Export AICode context as Markdown"
                    use-shortcut-of="EditorCopy">
            </action>
        </group>

        <group id="com.aicode.action.OpenGitRemoteGroup"
               text="Git Tools"
               icon="/icons/git.svg"
               popup="true">
            <add-to-group group-id="CutCopyPasteGroup"
                          anchor="after"
                          relative-to-action="AICodeGroup"/>
            <add-to-group group-id="EditorTabPopupMenu"
                          anchor="after"
                          relative-to-action="AICodeGroup"/>

            <action id="com.aicode.action.OpenGitRemoteAction"
                    class="com.aicode.feature.git.action.OpenGitRemoteAction"
                    text="Repository Home"
                    description="Open the origin repository in a browser"/>
            <action id="com.aicode.action.OpenGitRemoteBranchAction"
                    class="com.aicode.feature.git.action.OpenGitRemoteBranchAction"
                    text="Current Branch"
                    description="Open the current branch on the origin repository"/>
            <action id="com.aicode.action.OpenGitRemoteDirectoryAction"
                    class="com.aicode.feature.git.action.OpenGitRemoteDirectoryAction"
                    text="Selected Directory"
                    description="Open the selected directory on the current origin branch"/>
            <action id="com.aicode.action.OpenGitRemoteFileAction"
                    class="com.aicode.feature.git.action.OpenGitRemoteFileAction"
                    text="Selected File"
                    description="Open the selected file on the current origin branch"/>
            <separator/>
            <action id="com.aicode.action.CopyGitRemoteUrlAction"
                    class="com.aicode.feature.git.action.CopyGitRemoteUrlAction"
                    text="Copy Remote URL"
                    description="Copy the current Git repository origin URL"/>
            <action id="com.aicode.action.CreateChangelogAction"
                    class="com.aicode.feature.git.action.CreateChangelogAction"
                    text="Create or Update CHANGELOG.md..."
                    description="Create or update CHANGELOG.md from local Git tags and commits"/>
            <action id="com.aicode.action.GitTagReleaseAction"
                    class="com.aicode.feature.git.action.GitTagReleaseAction"
                    text="Create Release Tag..."
                    description="Create and push the next semantic version Git tag"/>
        </group>

        <group id="com.aicode.action.GitToolsMainMenuGroup"
               text="Git Tools"
               icon="/icons/git.svg"
               popup="true">
            <add-to-group group-id="Git.MainMenu" anchor="last"/>

            <reference ref="com.aicode.action.OpenGitRemoteAction"/>
            <reference ref="com.aicode.action.OpenGitRemoteBranchAction"/>
            <separator/>
            <reference ref="com.aicode.action.CopyGitRemoteUrlAction"/>
            <reference ref="com.aicode.action.CreateChangelogAction"/>
            <reference ref="com.aicode.action.GitTagReleaseAction"/>
        </group>
    </actions>

    <projectListeners>
        <listener class="com.aicode.feature.ai.listener.AICodeFileListener"
                  topic="com.intellij.openapi.vfs.newvfs.BulkFileListener"/>
    </projectListeners>
</idea-plugin>
